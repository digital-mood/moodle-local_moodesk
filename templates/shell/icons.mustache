{{!
    @template local_moodesk/shell/icons

    Inline SVG icon sprite for the application shell. Defined once per page and
    referenced by nav items via <use href="#mhd-icon-<token>">. Stroke-based,
    inherits currentColor; no external icon font or dependency.

    Icon tokens map to nav_item::$icon values produced by navigation_service.

    Context variables: none.

    Example context (json):
    {
    }
}}
<svg class="moodesk-app__icon-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    <defs>
        <symbol id="mhd-icon-dashboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
        </symbol>
        <symbol id="mhd-icon-tickets" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="6" width="18" height="12" rx="2"/>
            <line x1="12" y1="6" x2="12" y2="18" stroke-dasharray="2 2"/>
        </symbol>
        <symbol id="mhd-icon-newticket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </symbol>
        {{! The same glyph as `newticket`, under the name that says what it means
            wherever it is not about a ticket. `newticket` is a NAV key — it comes
            from \local_moodesk\service\nav_item and names a destination in the
            sidebar — so a "New department" button borrowing it read as a
            mislabel every time anyone opened the template. }}
        <symbol id="mhd-icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="5" x2="12" y2="19"/>
            <line x1="5" y1="12" x2="19" y2="12"/>
        </symbol>
        <symbol id="mhd-icon-departments" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="2.5"/>
            <circle cx="6" cy="12" r="2.5"/>
            <circle cx="18" cy="19" r="2.5"/>
            <line x1="8.2" y1="10.8" x2="15.8" y2="6.2"/>
            <line x1="8.2" y1="13.2" x2="15.8" y2="17.8"/>
