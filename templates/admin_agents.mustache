{{!
    @template local_moodesk/admin_agents

    Agent directory — roster of support agents (Agent Management A0).

    Lists every user holding the :agent capability, with their managed/unmanaged
    origin, department and plugin group membership, open-ticket workload and account
    status.

    Context variables:
      * agents[]   - Array of agent rows:
                       {fullname, email, avatar, managed, managedlabel,
                        departments[], hasdepartments, groups[], hasgroups, groupsempty,
                        openworkload, suspended, statuslabel}
      * hasagents  - True when at least one agent exists
      * nomembershiptext, nomembershiphint - The attention texts, naming plugin
                     groups when a plugin has them (agent_service::membership_text)
      * pageheader - Context for local_moodesk/page_header (built in agents.php)

    THE TABLE IS THE PRODUCT'S TABLE. Surface, header, row height, cell padding,
    hover, empty state and the phone treatment come from
    components/_datatable.scss; the controls above it sit in the shared
    layout/_table-toolbar.scss band; the name cell is the same entity cell the
    Departments list uses, with a face in it instead of a mark. What belongs to
    this screen is which columns exist and where each one lands once the row
    becomes a card — modules/_agents.scss.

    `table-reboot` alongside `.mhd-datatable` is not optional: Moodle 5 borders
    every `th` in a table that does not carry Bootstrap's `.table`, and that rule
    is past what our stylesheet can outrank.

    Below 992px the table is painted as one card per row. Same markup at every
    width — one loop, one set of cells — with each cell carrying its column name
    as real text in a .mhd-cell-label, hidden wherever the header row is doing
    that job instead.

    Example context (json):
    {
      "pageheader": {
        "title": "Agents",
        "description": "People who can be assigned tickets.",
        "meta": null,
        "actions": [
          {
            "label": "Manage in Moodle",
            "url": "/admin/roles/manage.php",
            "hasurl": true,
            "icon": null,
            "hasicon": false,
            "icononly": false,
            "variant": "outlined",
            "attributes": [
              {
                "name": "target",
                "value": "_blank"
              },
              {
                "name": "rel",
                "value": "noopener"
              }
            ],
            "hasattributes": true
          }
        ],
        "primaryaction": {
          "label": "Add agent",
          "url": "/local/moodesk/add_agent.php",
          "hasurl": true,
          "icon": "plus",
          "hasicon": true,
          "icononly": true,
          "variant": "filled",
          "attributes": [],
          "hasattributes": false
        },
        "hasactions": true
      },
      "hasagents": true,
      "nomembershiptext": "1 agent(s) belong to no department — they can only be assigned tickets with no department.",
      "nomembershiphint": "In no department — can only be assigned tickets with no department.",
      "agents": [
        {
          "fullname": "Ada Lovelace",
          "email": "ada@example.org",
          "avatar": "<span class=\"userpicture\"></span>",
          "managed": true,
          "managedlabel": "Managed by mooDesk",
          "departments": ["Support", "Billing"],
          "hasdepartments": true,
          "groups": ["Tier 1"],
          "hasgroups": true,
          "openworkload": 4,
          "suspended": false,
          "statuslabel": "Active"
        }
      ]
    }
}}
<div class="mhd-admin-agents">

  {{#pageheader}}{{> local_moodesk/page_header }}{{/pageheader}}

  {{#hastotal}}
  {{! Needs-attention states }}
  {{#hasnomembership}}
  <div class="alert alert-warning py-2" role="alert">
    {{nomembershiptext}}
  </div>
  {{/hasnomembership}}
  {{#hasemptydepts}}
  <div class="alert alert-warning py-2" role="alert">
    {{#str}} agents_attention_emptydepts, local_moodesk {{/str}}
    {{#emptydepts}}<span class="mhd-pill mhd-pill--outline ml-1">{{{name}}}</span>{{/emptydepts}}
  </div>
  {{/hasemptydepts}}

  {{! The table toolbar: the shared band every table's controls sit in. The
      controls inside it are the search field and selects from
      layout/_filters.scss, which were always generic — nothing in either was
      ever ticket-specific, which is why this screen reuses them rather than
      rebuilding them. }}
  <div class="mhd-table-toolbar">
    <form method="get" action="{{listurl}}" class="mhd-table-toolbar__filters">

      <div class="mhd-filter-search">
        <svg class="mhd-filter-search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="5.5" cy="5.5" r="4" stroke="#adb5bd" stroke-width="1.5"/>
          <path d="M9 9L12 12" stroke="#adb5bd" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input type="text" name="search" value="{{search}}" class="mhd-filter-search-input"
               placeholder="{{#str}} agents_filter_search, local_moodesk {{/str}}"
               aria-label="{{#str}} agents_filter_search, local_moodesk {{/str}}">
      </div>

      <div class="mhd-filter-select">
        <select name="departmentid" aria-label="{{#str}} agents_col_departments, local_moodesk {{/str}}">
          <option value="0">{{#str}} agents_filter_all_depts, local_moodesk {{/str}}</option>
          {{#deptoptions}}<option value="{{id}}" {{#selected}}selected{{/selected}}>{{{name}}}</option>{{/deptoptions}}
        </select>
      </div>

      {{#pluginfilterselects}}
      <div class="mhd-filter-select">
        <select name="{{name}}" aria-label="{{label}}">
          {{#options}}<option value="{{value}}"{{#isselected}} selected{{/isselected}}>{{label}}</option>{{/options}}
        </select>
      </div>
      {{/pluginfilterselects}}

      <div class="mhd-filter-select">
        <select name="status" aria-label="{{#str}} agents_col_status, local_moodesk {{/str}}">
          <option value="">{{#str}} agents_filter_all_status, local_moodesk {{/str}}</option>
          {{#statusoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/statusoptions}}
        </select>
      </div>

      <div class="mhd-filter-select">
        <select name="management" aria-label="{{#str}} agents_col_management, local_moodesk {{/str}}">
          <option value="">{{#str}} agents_filter_all_management, local_moodesk {{/str}}</option>
          {{#managementoptions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/managementoptions}}
        </select>
      </div>

      <div class="mhd-filter-apply">
        {{! Applying a filter is not the page's primary action — adding an agent
            is — so this is outlined, and clearing is the quieter of the pair. }}
        <button type="submit" class="mhd-btn mhd-btn--outlined mhd-btn--xsmall">{{#str}} agents_filter_apply, local_moodesk {{/str}}</button>
        {{#hasfilters}}
        <a href="{{listurl}}" class="mhd-btn mhd-btn--text mhd-btn--xsmall">{{#str}} agents_filter_clear, local_moodesk {{/str}}</a>
        {{/hasfilters}}
      </div>
    </form>
  </div>

  <p class="text-muted small mb-2">{{#str}} agents_count, local_moodesk, {"shown": {{shown}}, "total": {{total}}} {{/str}}</p>
  {{/hastotal}}

  {{#hasagents}}
  <div class="mhd-datatable-surface">
    {{! Six columns plus the row's own actions: wider than a laptop at any
        sensible font size, so above the desktop step the panel scrolls rather
        than dropping the last columns off the edge. Below it the rows are cards
        and there is nothing to scroll. }}
    <div class="mhd-datatable-scroll">
      <table class="mhd-datatable table-reboot mhd-agent-table">
        <caption class="mhd-sr-only">{{#str}} agents_heading, local_moodesk {{/str}}</caption>
        <thead>
          <tr>
            <th scope="col">{{#str}} agents_col_agent, local_moodesk {{/str}}</th>
            <th scope="col">{{#str}} agents_col_management, local_moodesk {{/str}}</th>
            <th scope="col">{{#str}} agents_col_departments, local_moodesk {{/str}}</th>
            {{#hasgroupscolumn}}<th scope="col">{{groupslabel}}</th>{{/hasgroupscolumn}}
            <th scope="col" class="mhd-cell--numeric">{{#str}} agents_col_workload, local_moodesk {{/str}}</th>
            <th scope="col">{{#str}} agents_col_status, local_moodesk {{/str}}</th>
            <th scope="col"><span class="mhd-sr-only">{{#str}} actions, local_moodesk {{/str}}</span></th>
          </tr>
        </thead>
        <tbody>
          {{#agents}}
          <tr>
            {{! A row header rather than a cell: the name identifies every other
                value in the row, and it is what titles the card below 992px.

                The entity cell is the same object the Departments list uses —
                same circle, same size, same left edge — with a photograph in it
                because an agent is a person. The name is plain text: the row's
                Detail button owns navigation, so the name is a label rather
                than a second route into the same screen. }}
            <th scope="row" class="mhd-cell--entity mhd-agent-name">
              <span class="mhd-entity">
                <span class="mhd-entity__avatar">{{{avatar}}}</span>
                <span class="mhd-entity__body">
                  {{! The attention badge is a sibling of the name, not a child
                      of it: the name truncates, and a badge nested inside it is
                      the first thing the ellipsis eats. }}
                  <span class="mhd-entity__title">
                    <span class="mhd-entity__name">{{fullname}}</span>
                    {{! Beside the name in the TABLE, where the identity column is the
                      only place it can go. Below 992px the card shows the copy in
                      the groups cell, or the departments one without it, instead and hides this one — see
                      modules/_agents.scss. Exactly one of the two is ever
                      rendered to the screen. }}
                  {{#nomembership}}<span class="mhd-agent-nomembership--identity mhd-entity__badge mhd-pill mhd-pill--warning" title="{{nomembershiphint}}">{{#str}} agents_attention_badge, local_moodesk {{/str}}</span>{{/nomembership}}
                  </span>
                  <span class="mhd-entity__meta">{{email}}</span>
                </span>
              </span>
            </th>
            {{! No .mhd-cell-label on the pill columns: the pill says what it is,
                and the word "Management" beside "Managed by mooDesk" would be a
                label carrying no information. }}
            <td class="mhd-agent-management">
              {{#managed}}
              <span class="mhd-pill mhd-pill--primary">{{managedlabel}}</span>
              {{/managed}}
              {{^managed}}
              <span class="mhd-pill mhd-pill--outline" title="{{#str}} agents_managed_moodle_hint, local_moodesk {{/str}}">
                {{managedlabel}}
              </span>
              {{/managed}}
            </td>
            {{! The flex list is a wrapper INSIDE the cell, never the cell
                itself: `display: flex` on a `<td>` takes it out of the table's
                layout algorithm and every column after it slides one place
                along. See components/_datatable.scss. }}
            <td class="mhd-agent-departments">
              <span class="mhd-tag-list">
                <span class="mhd-cell-label">{{#str}} agents_col_departments, local_moodesk {{/str}}</span>
                {{#hasdepartments}}
                {{#departments}}<span class="mhd-pill mhd-pill--outline">{{{.}}}</span>{{/departments}}
                {{/hasdepartments}}
                {{^hasdepartments}}
                <span class="text-muted small">{{#str}} agents_none, local_moodesk {{/str}}</span>
                {{/hasdepartments}}
              </span>
              {{^hasgroupscolumn}}{{#nomembership}}<span class="mhd-agent-nomembership mhd-pill mhd-pill--warning" title="{{nomembershiphint}}">{{#str}} agents_attention_badge, local_moodesk {{/str}}</span>{{/nomembership}}{{/hasgroupscolumn}}
            </td>
            {{#hasgroupscolumn}}
            <td class="mhd-agent-teams">
              <span class="mhd-tag-list">
                <span class="mhd-cell-label">{{groupslabel}}</span>
                {{#hasgroups}}
                {{#groups}}<span class="mhd-pill mhd-pill--outline">{{{.}}}</span>{{/groups}}
                {{/hasgroups}}
                {{^hasgroups}}
                <span class="text-muted small">{{groupsempty}}</span>
                {{/hasgroups}}
              </span>
              {{! The card's copy of the attention badge, sitting where "No team"
                  sits and reading against it. Hidden wherever the table is still
                  a table, because there the identity column carries it. A second
                  element rather than the same one moved: the badge has to be
                  beside the name in a table row and on this line in a card, and
                  one node cannot be in two cells at once. }}
              {{#nomembership}}<span class="mhd-agent-nomembership mhd-pill mhd-pill--warning" title="{{nomembershiphint}}">{{#str}} agents_attention_badge, local_moodesk {{/str}}</span>{{/nomembership}}
            </td>
            {{/hasgroupscolumn}}
            <td class="mhd-cell--numeric mhd-agent-workload mhd-cell-pair mhd-cell-pair--inline">
              <span class="mhd-cell-label">{{#str}} agents_col_workload, local_moodesk {{/str}}</span>{{openworkload}}
            </td>
            <td class="mhd-cell--status mhd-agent-status">
              <span class="mhd-pill {{^suspended}}mhd-pill--success{{/suspended}}{{#suspended}}mhd-pill--neutral{{/suspended}}">
                {{statuslabel}}
              </span>
            </td>
            <td class="mhd-cell--actions mhd-agent-actions">
              {{! Icon-only at the small size — 40px is a target a finger can
                  hit, and two of them side by side is where a near miss lands
                  on the wrong one. Each carries an aria-label AND a title:
                  nothing else in the row says what they do.

                  Removing an agent is the one destructive action here, so it is
                  the one that reads as destructive. Outlined rather than filled
                  because it repeats once per row, and a column of filled red
                  buttons is a page that looks like a warning. }}
              <div class="mhd-action-group">
                {{#detailurl}}
                <a href="{{detailurl}}" class="mhd-btn mhd-btn--outlined mhd-btn--icon"
                   aria-label="{{#str}} agents_detail_action, local_moodesk {{/str}}"
                   title="{{#str}} agents_detail_action, local_moodesk {{/str}}">
                  <svg class="mhd-btn__icon" aria-hidden="true" focusable="false">
                    <use href="#mhd-icon-view"></use>
                  </svg>
                </a>
                {{/detailurl}}
                {{#managed}}
                <a href="{{offboardurl}}" class="mhd-btn mhd-btn--outlined-danger mhd-btn--icon"
                   aria-label="{{#str}} agents_remove, local_moodesk {{/str}}"
                   title="{{#str}} agents_remove, local_moodesk {{/str}}">
                  <svg class="mhd-btn__icon" aria-hidden="true" focusable="false">
                    <use href="#mhd-icon-trash"></use>
                  </svg>
                </a>
                {{/managed}}
                {{^managed}}
                {{! An agent Moodle owns cannot be removed from here. The button
                    stays, disabled, rather than disappearing: an action that is
                    absent on some rows and present on others reads as an
                    inconsistency, while a disabled one with a reason attached
                    reads as an explanation. }}
                <button type="button" class="mhd-btn mhd-btn--outlined mhd-btn--icon" disabled
                        aria-label="{{#str}} agents_remove, local_moodesk {{/str}}"
                        title="{{#str}} agents_managed_moodle_hint, local_moodesk {{/str}}">
                  <svg class="mhd-btn__icon" aria-hidden="true" focusable="false">
                    <use href="#mhd-icon-trash"></use>
                  </svg>
                </button>
                {{/managed}}
              </div>
            </td>
          </tr>
          {{/agents}}
        </tbody>
      </table>
    </div>
  </div>
  {{/hasagents}}

  {{^hasagents}}
  {{! One empty state, inside the surface, exactly as on Departments: the panel
      is where the table would have been, so the page does not change shape when
      there is nothing to list. }}
  <div class="mhd-datatable-surface">
    <div class="mhd-datatable-empty">
      <div class="mhd-empty-state">
        <svg class="mhd-empty-state-icon" aria-hidden="true" focusable="false">
          <use href="#mhd-icon-users"></use>
        </svg>
        {{#hasfilters}}
        <p class="mhd-empty-state-desc">{{#str}} agents_filter_noresults, local_moodesk {{/str}}</p>
        {{! A way back from a filter that matched nothing: recovery, not
            invitation, so outlined rather than filled. }}
        <a href="{{listurl}}" class="mhd-btn mhd-btn--outlined">
          {{#str}} agents_filter_clear, local_moodesk {{/str}}
        </a>
        {{/hasfilters}}
        {{^hasfilters}}
        <p class="mhd-empty-state-desc">{{#str}} agents_empty, local_moodesk {{/str}}</p>
        {{! Nothing exists yet: this is the invitation, at the default size. }}
        <a href="{{addurl}}" class="mhd-btn mhd-btn--filled">
          <svg class="mhd-btn__icon" aria-hidden="true" focusable="false">
            <use href="#mhd-icon-newticket"></use>
          </svg>
          {{#str}} agents_add_heading, local_moodesk {{/str}}
        </a>
        {{/hasfilters}}
      </div>
    </div>
  </div>
  {{/hasagents}}

</div>
